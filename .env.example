# Server Settings
PORT=3008
NODE_ENV=production
BASE_URL=http://localhost:3008

# Publisher Access Token (Generate with: openssl rand -hex 24)
ARTIFACT_ACCESS_TOKEN=your_secure_random_token_here

# Storage & Database
MONGO_URI=mongodb://127.0.0.1:27017/open_artifacts
STORAGE_PATH=./data/artifacts
MAX_FILE_SIZE_MB=25

# Rate Limits (Requests per minute)
UPLOAD_RATE_LIMIT_PER_MIN=30
READ_RATE_LIMIT_PER_MIN=120
