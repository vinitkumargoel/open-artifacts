---
// HistoryDashboard — modular artifact history dashboard (/history)
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from './common/TopNav.astro';
import TokenModal from './common/TokenModal.astro';
import Toast from './common/Toast.astro';
import HistoryHeader from './history/HistoryHeader.astro';
import HistoryToolbar from './history/HistoryToolbar.astro';
import HistoryLoading from './history/HistoryLoading.astro';
import HistoryEmpty from './history/HistoryEmpty.astro';
import HistoryTable from './history/HistoryTable.astro';
import HistoryGrid from './history/HistoryGrid.astro';
import HistoryPagination from './history/HistoryPagination.astro';
import DeleteModal from './history/DeleteModal.astro';
import TtlModal from './history/TtlModal.astro';
import '../styles/history.css';
---
<BaseLayout title="OpenArtifacts • Artifact History">
  <TopNav subtitle="History Directory" activeSection="history" />

  <main class="main-container" id="historyMain">
    <HistoryHeader />
    <HistoryToolbar />
    <HistoryLoading />
    <HistoryEmpty />
    <HistoryTable />
    <HistoryGrid />
    <HistoryPagination />
  </main>

  <DeleteModal />
  <TokenModal />
  <TtlModal />
  <Toast defaultText="Notice" />

  <script src="../scripts/history/index.js"></script>
</BaseLayout>
