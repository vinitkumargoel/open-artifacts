---
// Retention (TTL) Configuration Modal
---
<div class="modal-backdrop" id="ttlModal" onclick="handleTtlBackdrop(event)">
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="ttlModalTitle" onclick="event.stopPropagation()">
    <div class="modal-header">
      <div class="modal-icon-token">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2"></path></svg>
      </div>
      <div class="modal-title-group">
        <h3 id="ttlModalTitle">Retention</h3>
        <p id="ttlModalDescription">Choose how long this artifact is kept before it is deleted automatically.</p>
      </div>
    </div>

    <div class="ttl-choices" id="ttlChoices">
      <button type="button" class="ttl-choice" data-ttl="7" onclick="selectTtlChoice(this)">7 days</button>
      <button type="button" class="ttl-choice" data-ttl="30" onclick="selectTtlChoice(this)">30 days</button>
      <button type="button" class="ttl-choice" data-ttl="90" onclick="selectTtlChoice(this)">90 days</button>
      <button type="button" class="ttl-choice" data-ttl="365" onclick="selectTtlChoice(this)">1 year</button>
      <button type="button" class="ttl-choice" data-ttl="never" onclick="selectTtlChoice(this)">Keep forever</button>
      <button type="button" class="ttl-choice" data-ttl="custom" onclick="selectTtlChoice(this)">Custom&hellip;</button>
    </div>

    <div class="modal-token-input" id="ttlCustomWrap" style="display: none;">
      <label for="ttlCustomInput">Days from now</label>
      <input type="number" id="ttlCustomInput" min="1" max="3650" step="1" placeholder="e.g. 14"
             oninput="onTtlCustomInput()" onkeydown="if (event.key === 'Enter') applyTtl()">
    </div>

    <!-- Inline Token Input (shown only when no token is stored) -->
    <div class="modal-token-input" id="ttlTokenWrap">
      <label for="ttlTokenInput">Access Token <span style="font-weight: 400; color: var(--text-tertiary);">(ARTIFACT_ACCESS_TOKEN)</span></label>
      <input type="password" id="ttlTokenInput" placeholder="Enter token to authorize the change">
    </div>

    <div class="token-hint" id="ttlModalHint">&nbsp;</div>

    <div class="modal-actions">
      <button type="button" class="btn-modal-cancel" onclick="closeTtlModal()">Cancel</button>
      <button type="button" class="btn-modal-save" id="ttlSaveBtn" onclick="applyTtl()" disabled>Update Retention</button>
    </div>
  </div>
</div>
