---
// UploadPortal — modular Studio publisher portal (/ and /upload)
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from './common/TopNav.astro';
import TokenModal from './common/TokenModal.astro';
import Toast from './common/Toast.astro';
import TemplateBar from './upload/TemplateBar.astro';
import ModeSelector from './upload/ModeSelector.astro';
import FileDropzone from './upload/FileDropzone.astro';
import CodeEditor from './upload/CodeEditor.astro';
import DiagnosticsBar from './upload/DiagnosticsBar.astro';
import StudioForm from './upload/StudioForm.astro';
import SuccessBanner from './upload/SuccessBanner.astro';
import PreviewPane from './upload/PreviewPane.astro';
import RecentsModal from './upload/RecentsModal.astro';
import ShortcutsModal from './upload/ShortcutsModal.astro';
import '../styles/upload.css';
---
<BaseLayout title="OpenArtifacts • Studio Publisher">
  <TopNav subtitle="Studio Publisher" activeSection="upload" />

  <main class="studio-grid">
    <div class="controls-pane">
      <TemplateBar />
      <ModeSelector />
      <FileDropzone />
      <CodeEditor />
      <DiagnosticsBar />
      <StudioForm />
      <SuccessBanner />
    </div>

    <PreviewPane />
  </main>

  <RecentsModal />
  <ShortcutsModal />
  <TokenModal />
  <Toast defaultText="Copied to clipboard" />

  <script src="../scripts/upload/index.js"></script>
</BaseLayout>
