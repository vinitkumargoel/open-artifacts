{
  "name": "open-artifacts",
  "version": "1.0.0",
  "description": "Self-Hosted Artifact Publishing, Versioning & Sandboxed Viewer Service",
  "main": "src/server.js",
  "bin": {
    "open-artifacts": "./bin/open-artifacts.js"
  },
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "astro dev",
    "dev:legacy": "node --watch src/server.js",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "migrate:r2": "node scripts/migrate-to-r2.mjs",
    "migrate:r2:remote": "node scripts/migrate-to-r2.mjs --remote",
    "test": "astro build && vitest run",
    "test:e2e": "astro build && vitest run test/e2e.worker.test.js",
    "test:watch": "vitest"
  },
  "keywords": [
    "artifacts",
    "html-hosting",
    "versioning",
    "claude-artifacts",
    "sandboxed-viewer",
    "self-hosted"
  ],
  "author": "Vinit & Antigravity",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "astro": "^7.2.4",
    "supertest": "^7.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
